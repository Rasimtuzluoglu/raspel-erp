# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433
# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USERNAME=raspel
RABBITMQ_PASSWORD=changeme
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# MinIO (S3 uyumlu nesne depolama)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# Yalnizca docker-compose.dev.yml icin host portlari (prod ile CAKISMAZ).
# Prod docker-compose.yml kendi sabit 127.0.0.1 portlarini kullanir.
# ---------------------------------------------------------------------------
DEV_POSTGRES_PORT=5434
DEV_REDIS_PORT=6380
DEV_RABBITMQ_PORT=5673
DEV_RABBITMQ_MGMT_PORT=15673
DEV_MINIO_PORT=9002
DEV_MINIO_CONSOLE_PORT=9003
DEV_ADMINER_PORT=8083

# JWT — zorunlu. Jar/code icinde on tanimli secret YOK (guvenlik fazi). En az 32 karakter.
# Uretmek icin: openssl rand -base64 48
# BOS birakilirsa prod profilinde uygulama baslamaz (fail-fast).
JWT_SECRET=

# AI yapilandirma API anahtarlarinin AES sifreleme anahtari (zorunlu, en az 16 karakter).
# Uretmek icin: openssl rand -base64 24
AI_ENCRYPTION_KEY=

# Grafana (zorunlu: guclu bir deger girin; bos/zayif parola kabul edilmez)
GRAFANA_USER=admin
GRAFANA_PASSWORD=

# Slack alert bildirimi (opsiyonel). Bos birakilirsa alertler yalnizca Alertmanager web arayuzunde gorunur.
# Slack webhook URL: https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_URL=

# SSL / Let's Encrypt (production'da domain adresinizi yazın)
ACME_EMAIL=admin@raspel.com
# Traefik host kurallari (config/traefik/dynamic.yml) bu degeri kullanir.
# Uygulamanın erişileceği alan adı (ör: erp.raspel.com). localhost BIRAKMAYIN.
APP_DOMAIN=erp.example.com

# Secure cookie + HTTPS zorunlulugu. Prod varsayilani true'dur (guvenli).
# Yerel HTTP gelistirmede (traefik http://localhost) false yapin.
APP_COOKIE_SECURE=true
APP_SECURITY_HTTPS_ONLY=true

# Gercek uretimde true kalmalidir: CORS/frontend URL'de localhost origin'lerini reddeder (fail-fast).
# Yerel gelistirme icin false yapin.
APP_SECURITY_STRICT_DOMAINS=true

# CORS (production'da frontend'in erişileceği tam origin; localhost yazmayin)
APP_CORS_ALLOWED_ORIGINS=https://erp.example.com

# Frontend taban adresi (şifre sıfırlama bağlantıları bu adresle üretilir)
APP_FRONTEND_URL=https://erp.example.com

# SMTP E-posta (production'da gerçek SMTP bilgilerinizi yazın)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=ornek@example.com
SPRING_MAIL_PASSWORD=degistir
SPRING_MAIL_FROM=ornek@example.com

# Traefik dashboard / adminer Basic Auth (htpasswd formatinda "kullanici:hash")
# Uretmek icin: docker run --rm httpd:alpine htpasswd -nb admin GUCLU_SIFRENIZ
# Bu degisken yoksa dashboard erisimi kapali kalir (fail-closed).
# Ornek deger YOKTUR; kendi hash'inizi uretin.
DASHBOARD_BASIC_AUTH=

# Web Push (VAPID) — PWA bildirimleri. Uretmek icin: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@raspel-erp.com

# Backend konteyner bellek ust siniri (cgroup). JVM yuzde tabanlidir
# (MaxRAMPercentage=65): heap bu sinirin ~%65'i olur. 8GB VPS / 10 kullanici /
# ~5000 islem-gun icin 2g onerilir; MINIMUM 1.5g'dir (1g'da JVM native+heap toplami
# tavani asar ve konteyner OOM ile olur). 16GB+ makinede 2.5g-3g verilebilir.
BACKEND_MEM_LIMIT=2g

# Izleme/proxy konteyner bellek tavanlari (8GB VPS butcesi)
TRAEFIK_MEM_LIMIT=256m
PROMETHEUS_MEM_LIMIT=512m
GRAFANA_MEM_LIMIT=384m
ALERTMANAGER_MEM_LIMIT=128m

# Konteyner CPU tavanlari. Bellek limiti tek basina yetmez: bir konteyner
# (ornegin pg_dump veya rapor sorgusu) cekirdeklerden birini tamamen tuketip
# veritabani/backend gecikmesine yol acabilir. Degerler CEKIRDEK SAYISINA GORE
# oynatilmalidir (4 cekirdekli VPS icin varsayilanlar; 2 cekirdekli makinede
# backend ve postgres degerlerini dusurun).
# Not: bunlar "reservation" degil "limit"tir; toplam core sayisini asmasi
# normaldir, limit yalnizca konteyner kendi payini asinca throttle devreye girer.
# Traefik icin ayrica TRAEFIK_CPU_LIMIT kullanilabilir.
POSTGRES_CPU_LIMIT=2.0
BACKEND_CPU_LIMIT=3.0
REDIS_CPU_LIMIT=0.5
RABBITMQ_CPU_LIMIT=1.0
MINIO_CPU_LIMIT=0.5
FRONTEND_CPU_LIMIT=0.5
ADMINER_CPU_LIMIT=0.2
NODE_EXPORTER_CPU_LIMIT=0.2
POSTGRES_EXPORTER_CPU_LIMIT=0.3
PROMETHEUS_CPU_LIMIT=0.5
GRAFANA_CPU_LIMIT=0.3
ALERTMANAGER_CPU_LIMIT=0.2
TRAEFIK_CPU_LIMIT=0.5

# Prometheus scrape token'i: /actuator/prometheus ucu bu token ile korunur.
# Backend ve Prometheus ayni degeri kullanir (docker secret). Uretmek icin:
#   openssl rand -hex 24
APP_METRICS_SCRAPE_TOKEN=

# Yuk testi (k6) hedef kullanici/sirket
LOADTEST_USER=admin_test
LOADTEST_PASSWORD=degistir
LOADTEST_SIRKET_ID=5
