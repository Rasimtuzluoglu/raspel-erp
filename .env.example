# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USERNAME=raspel
RABBITMQ_PASSWORD=changeme
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# JWT
JWT_SECRET=changeme-to-a-very-long-random-base64-string

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Slack alert bildirimi (opsiyonel). Bos birakilirsa alertler yalnizca Alertmanager web arayuzunde gorunur.
# Slack webhook URL: https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_URL=

# SSL / Let's Encrypt (production'da domain adresinizi yazın)
ACME_EMAIL=admin@raspel.com
# Uygulamanın erişileceği alan adı (ör: erp.raspel.com)
APP_DOMAIN=localhost

# SMTP E-posta (production'da gerçek SMTP bilgilerinizi yazın)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=ornek@example.com
SPRING_MAIL_PASSWORD=degistir
SPRING_MAIL_FROM=ornek@example.com

# Traefik dashboard / adminer Basic Auth (htpasswd formatinda "kullanici:hash")
# Uretmek icin: docker run --rm httpd:alpine htpasswd -nb admin GUCLU_SIFRENIZ
# Bu degisken yoksa dashboard erisimi kapali kalir (fail-closed).
DASHBOARD_BASIC_AUTH=admin:$apr1$sGKDQrlX$Nujz7U35Y9JhzcANtU9MX/
